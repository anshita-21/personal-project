# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Local embedded PostgreSQL (scripts/pg.sh) defaults to port 55432.
# If you use the Docker Compose stack instead, change the port to 5432.
DATABASE_URL="postgresql://examprep:examprep@127.0.0.1:55432/examprep?schema=public"

# Separate database used by the API integration test suite.
TEST_DATABASE_URL="postgresql://examprep:examprep@127.0.0.1:55432/examprep_test?schema=public"

# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# 32+ random chars. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime of the auth cookie.
JWT_EXPIRES_IN=7d
# Set to true behind HTTPS so the auth cookie carries the Secure attribute.
COOKIE_SECURE=false

# Comma separated list of browser origins allowed to call the API.
# Both spellings of the dev host are listed: "localhost" and "127.0.0.1" are
# DIFFERENT origins to a browser, and a request from the one that is not listed
# is rejected with 403 by the origin check.
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"

# Seed users (seed script only; demo credentials)
SEED_ADMIN_EMAIL="admin@examprep.dev"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_STUDENT_EMAIL="student@examprep.dev"
SEED_STUDENT_PASSWORD="Student123!"
