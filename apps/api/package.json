{
  "name": "@examprep/api",
  "version": "1.0.0",
  "private": true,
  "description": "Express REST + GraphQL API for the Exam Prep platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@examprep/shared": "1.0.0",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "graphql": "16.14.2",
    "graphql-http": "1.23.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
